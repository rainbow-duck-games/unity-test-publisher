{
  "name": "unity-test-publisher",
  "version": "0.2.6",
  "description": "Unity Test Publisher Action",
  "main": "lib/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "jest --verbose",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rainbow-duck-games/unity-test-publisher.git"
  },
  "keywords": [
    "actions",
    "unity",
    "tests"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rainbow-duck-games/unity-test-publisher/issues"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.4.0",
    "@octokit/types": "^16.0.0",
    "handlebars": "^4.7.10",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@vercel/ncc": "^0.36.1",
    "eslint": "^9.39.5",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^29.17.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-circus": "^30.5.2",
    "js-yaml": "^4.3.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
